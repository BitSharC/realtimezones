---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  url?: string;
}

const {
  title = "RealTimeZones — Coordinate Meetings Across Time Zones Instantly",
  description = "The fastest, most elegant timezone coordinator for remote teams, freelancers, and digital nomads. No registration, no ads, completely offline-capable.",
  url = "https://realtimezones.com"
} = Astro.props;
---
<!doctype html>
<html lang="en" class="overflow-x-hidden max-w-full w-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- PWA & Mobile Web App Meta Tags -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="RealTimeZones" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="application-name" content="RealTimeZones" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <!-- Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={url} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-image.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/og-image.png" />

    <!-- Synchronous local theme bootstrap; keeps CSP script-src self-compatible. -->
    <script src="/theme-init.js" is:inline></script>
  </head>
  <body class="bg-zinc-50 text-zinc-900 dark:bg-zinc-950 dark:text-zinc-100 min-h-screen selection:bg-zinc-900 selection:text-zinc-50 dark:selection:bg-zinc-100 dark:selection:text-zinc-900 transition-colors duration-150 antialiased overflow-x-hidden max-w-full w-full">
    <slot />

    <!-- Service worker registration stays in a same-origin external script. -->
    <script src="/register-sw.js" is:inline></script>
  </body>
</html>
