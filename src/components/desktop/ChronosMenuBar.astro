---
// Chronos Menu Bar Floating Flyout (Zen Menu Bar Glance Companion)
---

<div class="w-[360px] rounded-2xl border border-[#27272e] bg-[#0c0c0e] text-white font-['Geist',sans-serif] shadow-2xl overflow-hidden select-none p-4 flex flex-col gap-3.5">
  <!-- Inner Main Card Container with Hairline Border -->
  <div class="rounded-xl border border-[#202026] bg-[#111114] overflow-hidden flex flex-col">
    <!-- Header: Icon-Only Brand Logo + Workspace Selector + Expand Action -->
    <div class="h-12 px-3.5 border-b border-[#1c1c22] flex items-center justify-between bg-[#131317]">
      <div class="flex items-center gap-2.5">
        <!-- Icon-Only Brand Emblem with Silky Clock-Hand Sweep Animation -->
        <div 
          class="w-6 h-6 rounded-md border border-[#27272e] bg-[#141418] text-white flex items-center justify-center shrink-0 group hover:border-zinc-500/60 transition-colors cursor-pointer" 
          title="RealTimeZones"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" class="opacity-90 group-hover:opacity-100 transition-opacity" />
            <g class="origin-[12px_12px] group-hover:rotate-[360deg] transition-transform duration-700 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
              <line x1="12" y1="12" x2="12" y2="6" stroke-width="2.2" stroke-linecap="round" />
              <line x1="12" y1="12" x2="16" y2="14" stroke-width="2" stroke-linecap="round" />
              <circle cx="12" cy="12" r="1.2" fill="currentColor" />
            </g>
          </svg>
        </div>

        <span class="text-zinc-600 font-mono">|</span>

        <!-- Workspace Name Badge -->
        <div class="flex items-center gap-1.5 text-xs font-medium text-zinc-300">
          <span id="menubar-ws-name" class="tracking-tight truncate max-w-[150px]">My Workspace</span>
        </div>
      </div>

      <!-- Expand to Full Window Action -->
      <button 
        id="menubar-btn-expand"
        type="button" 
        class="w-7 h-7 rounded-lg border border-transparent hover:border-zinc-700/60 bg-transparent hover:bg-zinc-800/60 text-zinc-400 hover:text-white flex items-center justify-center transition-all cursor-pointer" 
        title="Expand to Full Workspace Window"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 3 21 3 21 9"/>
          <polyline points="9 21 3 21 3 15"/>
          <line x1="21" y1="3" x2="14" y2="10"/>
          <line x1="3" y1="21" x2="10" y2="14"/>
        </svg>
      </button>
    </div>

    <!-- Dynamic City Cards Stack -->
    <div id="menubar-cities-list" class="divide-y divide-[#1a1a22] max-h-[320px] overflow-y-auto">
      <!-- Dynamically populated by chronos-interactions.ts -->
    </div>

    <!-- Overlap Ribbon Section -->
    <div class="p-3.5 border-t border-[#1c1c22] bg-[#0e0e12] flex flex-col gap-2">
      <div class="flex items-center justify-between text-[10px] font-mono uppercase tracking-wider">
        <span class="text-zinc-400 font-medium">COMMON OVERLAP</span>
        <span id="menubar-overlap-text" class="text-emerald-400 font-semibold truncate max-w-[190px]">Calculating...</span>
      </div>

      <!-- 24-Hour Continuous Overlap Bar -->
      <div class="relative h-2 w-full rounded-full bg-[#181820] overflow-hidden flex items-center">
        <!-- Subtle Hour Tick marks -->
        <div class="absolute inset-0 flex justify-between px-1 pointer-events-none opacity-20">
          <span class="w-px h-full bg-zinc-500"></span>
          <span class="w-px h-full bg-zinc-500"></span>
          <span class="w-px h-full bg-zinc-500"></span>
          <span class="w-px h-full bg-zinc-500"></span>
        </div>
        <!-- Active Overlap Highlight -->
        <div 
          id="menubar-overlap-bar"
          class="absolute h-full rounded bg-emerald-500 shadow-[0_0_10px_rgba(52,211,153,0.8)] transition-all duration-300"
          style="left: 37.5%; width: 25%;"
        ></div>
      </div>
    </div>
  </div>

  <!-- Bottom Action Buttons: Quick Add + Copy Overlap Window -->
  <div class="flex items-center gap-2">
    <button 
      id="menubar-btn-add"
      type="button" 
      class="h-10 px-3 rounded-xl border border-[#272730] bg-[#121216] hover:bg-[#1a1a20] text-xs text-zinc-300 hover:text-white flex items-center gap-1.5 transition-all cursor-pointer shrink-0"
      title="Add City (⌘K)"
    >
      <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5v14"/></svg>
      <span>Add</span>
    </button>

    <button 
      id="menubar-btn-copy-overlap"
      type="button" 
      class="flex-1 h-10 rounded-xl border border-[#272730] bg-[#121216] hover:bg-[#1a1a20] text-xs font-mono uppercase tracking-wider text-zinc-200 hover:text-white flex items-center justify-center gap-2 transition-all cursor-pointer shadow-sm active:scale-[0.99]"
    >
      <svg class="w-3.5 h-3.5 text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
      <span id="menubar-copy-label">COPY OVERLAP</span>
    </button>
  </div>
</div>
