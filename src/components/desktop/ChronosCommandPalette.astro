---
// Unified Chronos Raycast Quick Action Launcher & Spotlight Omnibar (Single Modal for Everything)
---

<div 
  id="chronos-command-modal" 
  class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 items-center justify-center p-4 hidden"
>
  <div class="w-full max-w-[640px] rounded-2xl border border-[#22222a] bg-[#0c0c0f] text-white font-['Geist',sans-serif] shadow-2xl overflow-hidden select-none animate-in fade-in zoom-in-95 duration-150 p-3 flex flex-col gap-3">
    <!-- Curvy Minimalist Omnibar Search Input -->
    <div class="h-13 px-4 rounded-xl border border-[#272734] bg-[#121217] flex items-center justify-between gap-3 shadow-inner">
      <div class="flex items-center gap-3 flex-1 min-w-0">
        <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        
        <input 
          id="chronos-command-input"
          type="text" 
          placeholder="Search city to add, type time query (e.g. 3 PM London in Tokyo), or command..."
          class="w-full bg-transparent border-0 ring-0 outline-none text-xs sm:text-sm text-white placeholder-zinc-500 font-normal focus:outline-none focus:ring-0 focus-visible:outline-none focus:border-0"
          style="outline: none !important; box-shadow: none !important; border: none !important;"
        />
      </div>

      <!-- Right Shortcuts -->
      <div class="flex items-center gap-1.5 shrink-0">
        <button id="chronos-close-cmd" type="button" class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-[#1c1c24] text-zinc-400 border border-[#2a2a34] hover:text-white cursor-pointer transition-colors" title="Close (ESC)">
          ESC
        </button>
        <span class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-[#1c1c24] text-zinc-400 border border-[#2a2a34] flex items-center gap-1">
          <span>↵</span>
          <span>to select</span>
        </span>
      </div>
    </div>

    <!-- Dynamic Omnibar Results Container -->
    <div id="chronos-omnibar-results" class="max-h-[380px] overflow-y-auto px-1 pb-1 flex flex-col gap-3 scroll-smooth">
      <!-- Injected and updated dynamically by JS based on query type -->
    </div>

    <!-- Omnibar Bottom Status Footer -->
    <div class="px-2 pt-2 border-t border-[#1a1a22] flex items-center justify-between text-[11px] font-mono text-zinc-500">
      <div class="flex items-center gap-3">
        <span><kbd class="text-[10px] bg-[#16161e] border border-[#272734] px-1.5 py-0.5 rounded text-zinc-400">↑</kbd> <kbd class="text-[10px] bg-[#16161e] border border-[#272734] px-1.5 py-0.5 rounded text-zinc-400">↓</kbd> Navigate</span>
        <span><kbd class="text-[10px] bg-[#16161e] border border-[#272734] px-1.5 py-0.5 rounded text-zinc-400">↵</kbd> Select</span>
      </div>
      <div class="flex items-center gap-1.5 text-zinc-500">
        <span><kbd class="text-[10px] bg-[#16161e] border border-[#272734] px-1.5 py-0.5 rounded text-zinc-400">ESC</kbd> Close</span>
      </div>
    </div>
  </div>
</div>
