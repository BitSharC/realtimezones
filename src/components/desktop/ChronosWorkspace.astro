<style is:global>
  /* Intro Splash Pure SVG Animations */
  @keyframes introCircleDraw {
    0% { stroke-dashoffset: 130; opacity: 0; }
    20% { opacity: 1; }
    100% { stroke-dashoffset: 0; opacity: 1; }
  }
  @keyframes introHandsSweep {
    0% { transform: rotate(0deg); opacity: 0; }
    20% { opacity: 1; }
    100% { transform: rotate(360deg); opacity: 1; }
  }
  @keyframes introTextFade {
    0% { opacity: 0; transform: translateY(12px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .animate-intro-circle {
    animation: introCircleDraw 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .animate-intro-hands {
    animation: introHandsSweep 1.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards 0.2s;
  }
  .animate-intro-text {
    animation: introTextFade 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards 0.9s;
    opacity: 0;
  }

  /* Prevent Text Selection During Timeline Scrubbing */
  body.is-scrubbing,
  body.is-scrubbing * {
    user-select: none !important;
    -webkit-user-select: none !important;
    cursor: ew-resize !important;
  }

