---
// Chronos Full Desktop Workspace Canvas (Prototype 1 - Complete Workspace Management & City Actions)

// Availability color helper matching the website logic:
// 1. Working (8a - 6p): Emerald tint
// 2. Border/Awake (6a - 8a & 6p - 10p): Amber tint
// 3. Sleep/Night (10p - 6a): Dark Zinc/Night tint
const getHourStatusClass = (localHour: number) => {
  if (localHour >= 8 && localHour < 18) {
    return 'bg-emerald-950/40 border-r border-emerald-900/30 hover:bg-emerald-900/60';
  }
  if ((localHour >= 6 && localHour < 8) || (localHour >= 18 && localHour < 22)) {
    return 'bg-amber-950/30 border-r border-amber-900/25 hover:bg-amber-900/50';
  }
  return 'bg-[#08080b] border-r border-[#14141a] hover:bg-zinc-900/60';
};
---

<div id="chronos-root" class="flex flex-col h-full w-full bg-[#0a0a0c] text-white font-['Geist',sans-serif] select-none overflow-hidden relative">
  <!-- Top App Toolbar (52px) -->
  <header class="h-[52px] border-b border-[#202024] bg-[#0d0d10] px-5 flex items-center justify-between z-30 shrink-0">
    <!-- Left Navigation -->
    <div class="flex items-center gap-3">
      <!-- Icon-Only Brand Logo with Silky Clock-Hand Sweep Animation -->
      <a 
        id="chronos-btn-logo"
        href="/" 
        class="chronos-logo-btn w-7 h-7 rounded-lg border border-[#27272e] bg-[#141418] hover:bg-[#1c1c22] hover:border-zinc-500/60 text-zinc-300 hover:text-white flex items-center justify-center transition-all cursor-pointer group shrink-0 relative shadow-xs active:scale-95" 
        title="RealTimeZones • Workspace"
        aria-label="RealTimeZones Home"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <!-- Outer Bezel -->
          <circle cx="12" cy="12" r="10" class="opacity-90 group-hover:opacity-100 transition-opacity" />
          <!-- Animated Hands (Minute + Hour) with Center Pivot -->
          <g class="origin-[12px_12px] group-hover:rotate-[360deg] transition-transform duration-700 ease-[cubic-bezier(0.34,1.56,0.64,1)]">
            <line x1="12" y1="12" x2="12" y2="6" stroke-width="2.2" stroke-linecap="round" />
            <line x1="12" y1="12" x2="16" y2="14" stroke-width="2" stroke-linecap="round" />
            <circle cx="12" cy="12" r="1.2" fill="currentColor" />
          </g>
        </svg>
      </a>

      <!-- Workspace Selector Dropdown Container -->
      <div class="relative">
        <button 
          id="chronos-workspace-btn" 
          type="button" 
          class="h-7 px-2.5 rounded-lg border border-[#27272e] bg-[#141418] hover:bg-[#1c1c22] text-xs text-zinc-300 flex items-center gap-1.5 transition-colors cursor-pointer"
        >
          <svg class="w-3.5 h-3.5 text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/></svg>
          <span id="chronos-workspace-name">Core Engineering</span>
          <svg class="w-3 h-3 text-zinc-400 transition-transform" id="chronos-workspace-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </button>

        <!-- Dropdown Menu (Hidden by default) -->
        <div 
          id="chronos-workspace-dropdown" 
          class="absolute top-9 left-0 w-72 rounded-xl border border-[#272732] bg-[#111116] text-white shadow-2xl p-1.5 hidden flex-col gap-1 z-50 animate-in fade-in zoom-in-95 duration-100"
        >
          <div class="px-2.5 py-1 text-[10px] font-mono uppercase tracking-wider text-zinc-500 font-semibold flex items-center justify-between">
            <span>Workspaces</span>
            <span id="chronos-ws-total-badge" class="text-zinc-600">3 teams</span>
          </div>

          <div id="chronos-workspace-list" class="flex flex-col gap-0.5 max-h-56 overflow-y-auto">
            <!-- Populated dynamically with Rename & Delete hover buttons -->
          </div>

          <div class="h-px bg-[#1e1e26] my-1"></div>

          <!-- Create Workspace Action -->
          <button 
            id="chronos-create-workspace-btn" 
            type="button" 
            class="w-full px-2.5 py-1.5 rounded-lg text-xs text-zinc-300 hover:text-white hover:bg-[#1c1c24] flex items-center gap-2 transition-colors cursor-pointer"
          >
            <svg class="w-3.5 h-3.5 text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5v14"/></svg>
            <span>New Workspace...</span>
          </button>
        </div>
      </div>

      <!-- Date Selector Pill & Interactive Calendar Popover -->
      <div class="relative">
        <button 
          id="chronos-date-btn"
          type="button" 
          class="h-7 px-2.5 rounded-lg border border-[#27272e] bg-[#141418] hover:bg-[#1c1c22] text-xs text-zinc-300 flex items-center gap-1.5 transition-colors cursor-pointer"
          title="Change active date"
        >
          <svg class="w-3.5 h-3.5 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          <span id="chronos-current-date-label">Mon, Aug 24</span>
          <svg class="w-3 h-3 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </button>

        <!-- Interactive Calendar Dropdown (Hidden by default) -->
        <div 
          id="chronos-date-dropdown" 
          class="absolute top-9 left-0 w-64 rounded-2xl border border-[#272734] bg-[#111116] text-white shadow-2xl p-3 hidden flex-col gap-2.5 z-50 animate-in fade-in zoom-in-95 duration-100"
        >
          <!-- Header: Direct Month & Year Selectors + Navigation Arrows -->
          <div class="flex items-center justify-between border-b border-[#1f1f28] pb-2">
            <div class="flex items-center gap-1.5">
              <!-- Manual Month Picker -->
              <select 
                id="chronos-cal-month-select" 
                class="bg-[#181820] hover:bg-[#20202a] text-xs font-semibold text-white px-2 py-0.5 rounded-lg border border-[#272734] cursor-pointer outline-none transition-colors"
                title="Jump to Month"
              >
                <option value="0">January</option>
                <option value="1">February</option>
                <option value="2">March</option>
                <option value="3">April</option>
                <option value="4">May</option>
                <option value="5">June</option>
                <option value="6">July</option>
                <option value="7">August</option>
                <option value="8">September</option>
                <option value="9">October</option>
                <option value="10">November</option>
                <option value="11">December</option>
              </select>

              <!-- Manual Year Picker -->
              <select 
                id="chronos-cal-year-select" 
                class="bg-[#181820] hover:bg-[#20202a] text-xs font-mono font-semibold text-white px-1.5 py-0.5 rounded-lg border border-[#272734] cursor-pointer outline-none transition-colors"
                title="Jump to Year"
              >
                <option value="2024">2024</option>
                <option value="2025">2025</option>
                <option value="2026">2026</option>
                <option value="2027">2027</option>
                <option value="2028">2028</option>
                <option value="2029">2029</option>
                <option value="2030">2030</option>
              </select>
            </div>

            <div class="flex items-center gap-1 text-zinc-400">
              <button id="chronos-cal-prev-month" type="button" class="w-6 h-6 flex items-center justify-center hover:text-white rounded hover:bg-zinc-800 cursor-pointer font-bold text-sm" title="Previous Month">‹</button>
              <button id="chronos-cal-next-month" type="button" class="w-6 h-6 flex items-center justify-center hover:text-white rounded hover:bg-zinc-800 cursor-pointer font-bold text-sm" title="Next Month">›</button>
            </div>
          </div>

          <!-- Weekdays Header -->
          <div class="grid grid-cols-7 gap-1 text-center font-mono text-[10px] text-zinc-500">
            <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
          </div>

          <!-- Days Grid (Dynamically rendered by JS) -->
          <div id="chronos-calendar-days" class="grid grid-cols-7 gap-1 text-center font-mono text-xs">
          </div>

          <!-- Calendar Quick Actions -->
          <div class="flex items-center justify-between pt-2 border-t border-[#1f1f28] text-[11px] font-mono">
            <button id="chronos-cal-today" type="button" class="text-emerald-400 hover:underline cursor-pointer">Today</button>
            <button id="chronos-cal-tomorrow" type="button" class="text-zinc-400 hover:text-white cursor-pointer">Tomorrow</button>
            <button id="chronos-cal-next-week" type="button" class="text-zinc-400 hover:text-white cursor-pointer">+1 Week</button>
          </div>
        </div>
      </div>
      <!-- Now Button (Snap to current moment) -->
      <button 
        id="chronos-btn-now" 
        type="button" 
        class="h-7 px-2.5 rounded-lg border border-[#27272e] bg-[#141418] hover:bg-[#1c1c22] hover:border-emerald-500/50 text-xs font-mono text-emerald-400 flex items-center gap-1.5 transition-all cursor-pointer active:scale-95 outline-none focus:outline-none"
        title="Snap timeline to current time (Shortcut: N)"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shadow-[0_0_6px_rgba(52,211,153,0.8)]"></span>
        <span>Now</span>
      </button>
    </div>

    <!-- Right Controls -->
    <div class="flex items-center gap-3">
      <!-- Search Input / Add City Trigger -->
      <button 
        type="button" 
        class="trigger-cmd-k h-7 w-48 sm:w-56 px-2.5 rounded-lg border border-[#27272e] bg-[#141418] hover:border-zinc-500 text-xs text-zinc-400 flex items-center justify-between transition-colors cursor-pointer outline-none focus:outline-none"
      >
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <span>Search & Add...</span>
        </span>
        <kbd class="text-[10px] font-mono text-zinc-500 bg-zinc-800/80 px-1.5 py-0.5 rounded border border-zinc-700">⌘K</kbd>
      </button>

      <!-- 12h / 24h Segment Toggle -->
      <div class="h-7 p-0.5 rounded-lg border border-[#27272e] bg-[#141418] flex items-center text-[11px] font-mono">
        <button id="chronos-toggle-12h" type="button" class="px-2 py-0.5 rounded text-zinc-400 hover:text-white transition-colors cursor-pointer outline-none focus:outline-none">12h</button>
        <button id="chronos-toggle-24h" type="button" class="px-2 py-0.5 rounded bg-zinc-800 text-white font-medium transition-colors cursor-pointer outline-none focus:outline-none">24h</button>
      </div>

      <!-- Menu Bar Glance Popover Button -->
      <button 
        id="chronos-btn-toggle-menubar-view" 
        type="button" 
        class="h-7 px-2.5 rounded-lg border border-[#27272e] bg-[#141418] hover:bg-[#1c1c22] hover:border-zinc-500/60 text-zinc-400 hover:text-white flex items-center gap-1.5 transition-colors cursor-pointer outline-none focus:outline-none"
        title="Open Companion Menu Bar Popover Glance (⌘M)"
      >
        <svg class="w-3.5 h-3.5 text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
        <span class="text-[11px] font-medium hidden sm:inline">Menu Bar</span>
      </button>

      <!-- Settings Button -->
      <button 
        id="chronos-btn-settings" 
        type="button" 
        class="h-7 w-7 rounded-lg border border-[#27272e] bg-[#141418] hover:bg-[#1c1c22] hover:text-white text-zinc-400 flex items-center justify-center transition-colors cursor-pointer outline-none focus:outline-none"
        title="Settings (⌘,)"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
      </button>
    </div>
  </header>

  <!-- Focus Scrubber Header Bar (Top hour indicator scale) -->
  <div id="chronos-scrubber-header" class="h-7 bg-[#0a0a0c] border-b border-[#202024] flex items-center relative pl-[280px] cursor-ew-resize select-none">
    <div 
      id="chronos-focus-tag" 
      class="absolute top-1/2 -translate-y-1/2 font-mono text-[11px] font-semibold px-2 py-0.5 rounded-md border border-zinc-700 bg-[#16161c] text-zinc-100 shadow-md -translate-x-1/2 cursor-grab active:cursor-grabbing z-30 transition-transform hover:scale-105 active:scale-95" 
      style="left: 65%;"
    >
      13:00
    </div>
  </div>

  <!-- Main Multi-City Canvas with Bento Grid -->
  <div class="flex-1 overflow-y-auto flex flex-col relative select-none pb-28" id="chronos-canvas-container">
    <div class="relative min-h-full flex flex-col w-full flex-1" id="chronos-canvas-inner">
      <!-- Synchronized Vertical Focus Line (Calibrated Soft Contrast) -->
      <div 
        id="chronos-focus-line" 
        class="absolute top-0 w-[1.5px] bg-zinc-200/90 shadow-[0_0_6px_rgba(255,255,255,0.3)] z-20 pointer-events-none"
        style="left: 65%; height: 100%;"
      >
        <div class="absolute -top-1 left-1/2 -translate-x-1/2 w-1.5 h-1.5 rounded-full bg-zinc-200 shadow-[0_0_4px_rgba(255,255,255,0.5)]"></div>
      </div>

      <!-- Dynamic City Rows Container (Rendered by JS) -->
      <div id="chronos-city-rows" class="flex flex-col">
        <!-- Injected dynamically by chronos-interactions.ts -->
      </div>

      <!-- + Add City to Workspace Row & Inline Availability Legend Footer -->
      <div id="chronos-add-city-row" class="py-6 px-6 flex flex-col sm:flex-row items-center justify-between gap-4 border-b border-[#1c1c24] bg-transparent shrink-0">
        <!-- Left balancer spacer -->
        <div class="hidden sm:block w-48 shrink-0"></div>

        <!-- Center: + Add City to Workspace Button -->
        <button 
          id="chronos-btn-add-city"
          type="button" 
          class="h-10 px-6 rounded-xl border border-[#272734] bg-[#14141c] hover:bg-[#1c1c26] hover:border-zinc-500 text-xs font-medium text-zinc-300 hover:text-white flex items-center gap-2.5 transition-all cursor-pointer shadow-md active:scale-95 outline-none focus:outline-none shrink-0"
        >
          <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5v14"/></svg>
          <span>Add Teammate / City</span>
          <kbd class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-[#0d0d12] text-zinc-500 border border-zinc-800">⌘K</kbd>
        </button>

        <!-- Right: Subtle Availability Legend -->
        <div class="flex items-center gap-3 text-[10px] font-mono text-zinc-400 shrink-0">
          <div class="flex items-center gap-1.5" title="Working Hours: 8:00 AM - 6:00 PM">
            <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_6px_rgba(52,211,153,0.7)]"></span>
            <span class="text-zinc-300">Working</span>
          </div>
          <span class="text-zinc-600">•</span>
          <div class="flex items-center gap-1.5" title="Border Hours: 6:00 AM - 8:00 AM & 6:00 PM - 10:00 PM">
            <span class="w-2 h-2 rounded-full bg-amber-400 shadow-[0_0_6px_rgba(251,191,36,0.7)]"></span>
            <span class="text-zinc-300">Border</span>
          </div>
          <span class="text-zinc-600">•</span>
          <div class="flex items-center gap-1.5" title="Sleep Hours: 10:00 PM - 6:00 AM">
            <span class="w-2 h-2 rounded-full border border-zinc-600 bg-zinc-800"></span>
            <span class="text-zinc-500">Sleep</span>
          </div>
        </div>
      </div>

      <!-- Guaranteed Bottom Floating Dock Clearance Spacer (Never overlaps) -->
      <div class="h-36 shrink-0 w-full pointer-events-none"></div>

      <!-- Empty Workspace State (Shown when all cities are deleted) -->
      <div id="chronos-empty-state" class="hidden flex-col items-center justify-center p-16 text-center gap-3">
        <div class="w-12 h-12 rounded-2xl bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-400">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        </div>
        <div class="text-sm font-semibold text-white">This workspace is empty</div>
        <p class="text-xs text-zinc-500 max-w-xs">Add cities to start scheduling and finding overlap hours with your team.</p>
        <button 
          id="chronos-btn-add-city-empty" 
          type="button" 
          class="mt-2 h-8 px-4 rounded-lg bg-white text-zinc-950 font-semibold text-xs hover:bg-zinc-200 transition-colors cursor-pointer"
        >
          + Add First City
        </button>
      </div>
    </div>
  </div>

  <!-- Bottom Expandable Intelligence Dock & Overlap Capsule -->
  <div class="absolute bottom-5 left-1/2 -translate-x-1/2 z-30 flex flex-col items-center gap-2 w-full max-w-4xl px-4 pointer-events-none">
    <!-- Sliding Intelligence Bento Panel (Expandable) -->
    <div 
      id="chronos-intelligence-panel" 
      class="w-full rounded-2xl border border-[#272734] bg-[#0c0c11]/95 backdrop-blur-xl p-4 shadow-2xl hidden flex-col gap-4 animate-in fade-in slide-in-from-bottom-3 duration-150 pointer-events-auto"
    >
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Left: Meeting Quality & Smart Recommendations Card -->
        <div class="rounded-xl border border-[#20202a] bg-[#121218] p-4 flex flex-col justify-between gap-3 shadow-inner">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-mono uppercase tracking-wider text-zinc-500 font-semibold">MEETING QUALITY</span>
            <div class="flex items-center gap-2">
              <span id="chronos-quality-stars" class="text-amber-400 text-xs">★★★★★</span>
              <span id="chronos-quality-badge" class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 font-semibold">EXCELLENT</span>
            </div>
          </div>

          <div class="flex flex-col gap-0.5">
            <div id="chronos-quality-title" class="text-xs font-semibold text-white">All active participants inside working hours.</div>
            <div id="chronos-quality-desc" class="text-[11px] text-zinc-400">All participants are within optimal working hours (8:00 AM - 6:00 PM).</div>
          </div>

          <!-- Smart Recommendations -->
          <div class="flex flex-col gap-2 pt-2.5 border-t border-[#1c1c24]">
            <div class="flex items-center justify-between text-[10px] font-mono text-zinc-500">
              <span class="font-semibold text-zinc-400">SMART RECOMMENDATIONS</span>
              <span id="chronos-recs-desc">Optimal for 60m meeting</span>
            </div>
            <div class="flex items-center gap-2" id="chronos-recommendation-pills">
              <button type="button" data-snap-hour="13" class="px-2.5 py-1 rounded-lg bg-white text-zinc-950 text-xs font-mono font-bold hover:bg-zinc-200 transition-colors cursor-pointer shadow-sm">
                Best: 1:00 PM
              </button>
              <button type="button" data-snap-hour="14" class="px-2.5 py-1 rounded-lg bg-[#1a1a24] text-zinc-300 border border-[#2a2a36] text-xs font-mono hover:text-white hover:bg-[#222230] transition-colors cursor-pointer">
                2nd: 2:00 PM
              </button>
              <button type="button" data-snap-hour="15" class="px-2.5 py-1 rounded-lg bg-[#1a1a24] text-zinc-300 border border-[#2a2a36] text-xs font-mono hover:text-white hover:bg-[#222230] transition-colors cursor-pointer">
                3rd: 3:00 PM
              </button>
            </div>
          </div>
        </div>

        <!-- Right: Export Meeting Slot & Duration Card -->
        <div class="rounded-xl border border-[#20202a] bg-[#121218] p-4 flex flex-col justify-between gap-3 shadow-inner">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-mono uppercase tracking-wider text-zinc-500 font-semibold">EXPORT MEETING SLOT</span>
            <span id="chronos-selected-duration-badge" class="text-[10px] font-mono px-2 py-0.5 rounded bg-zinc-800 text-zinc-300 border border-zinc-700 font-medium">Duration: 1h</span>
          </div>

          <!-- Meeting Duration Segment Buttons -->
          <div class="flex flex-col gap-1.5">
            <span class="text-[10px] font-mono text-zinc-500">MEETING DURATION</span>
            <div class="grid grid-cols-4 gap-1.5" id="chronos-duration-pills">
              <button type="button" data-duration="30" class="py-1 rounded-lg bg-[#181822] text-zinc-400 hover:text-white border border-[#252532] text-xs font-mono transition-colors cursor-pointer text-center">30m</button>
              <button type="button" data-duration="60" class="py-1 rounded-lg bg-white text-zinc-950 font-bold border border-white text-xs font-mono transition-colors cursor-pointer text-center shadow-sm">1h</button>
              <button type="button" data-duration="90" class="py-1 rounded-lg bg-[#181822] text-zinc-400 hover:text-white border border-[#252532] text-xs font-mono transition-colors cursor-pointer text-center">90m</button>
              <button type="button" data-duration="120" class="py-1 rounded-lg bg-[#181822] text-zinc-400 hover:text-white border border-[#252532] text-xs font-mono transition-colors cursor-pointer text-center">2h</button>
            </div>
          </div>

