---
// Header Component for RealTimeZones
---
<header class="sticky top-0 z-30 w-full border-b border-zinc-200 dark:border-zinc-800 bg-white/85 dark:bg-black/85 backdrop-blur-md transition-colors duration-150">
  <div class="max-w-[1400px] mx-auto px-4 md:px-8 h-16 flex items-center justify-between">
    
    <!-- Logo & Brand -->
    <a href="/" class="flex items-center gap-2.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-purple-500 rounded-md">
      <!-- Premium Logo Icon -->
      <span class="text-zinc-900 dark:text-zinc-50 shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-[23px] h-[23px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
      </span>
      <div class="flex flex-col">
        <h1 class="text-sm font-bold tracking-tight text-zinc-900 dark:text-zinc-50 leading-none">RealTimeZones</h1>
        <span class="text-[9px] text-zinc-500 dark:text-zinc-400 font-mono mt-1.5 tracking-wide leading-none">THE FASTEST TIME SYNC</span>
      </div>
    </a>

    <!-- Navigation & Action Elements -->
    <div class="flex items-center gap-2 md:gap-4">
      
      <!-- Theme Switcher Pill -->
      <div class="hidden sm:flex items-center bg-zinc-100 dark:bg-zinc-900 p-0.5 rounded-lg border border-zinc-200/50 dark:border-zinc-800">
        <button 
          type="button" 
          data-theme="system" 
          class="theme-btn px-2.5 py-1 rounded-md text-xs font-medium cursor-pointer transition-colors duration-150"
          title="Use system preference"
        >
          System
        </button>
        <button 
          type="button" 
          data-theme="light" 
          class="theme-btn px-2.5 py-1 rounded-md text-xs font-medium cursor-pointer transition-colors duration-150"
          title="Light mode"
        >
          Light
        </button>
        <button 
          type="button" 
          data-theme="dark" 
          class="theme-btn px-2.5 py-1 rounded-md text-xs font-medium cursor-pointer transition-colors duration-150"
          title="Dark mode"
        >
          Dark
        </button>
      </div>

      <!-- Time Format Switcher Pill -->
      <div class="flex items-center bg-zinc-100 dark:bg-zinc-900 p-0.5 rounded-lg border border-zinc-200/50 dark:border-zinc-800">
        <button 
          type="button" 
          id="time-format-12h" 
          class="time-format-btn px-2.5 py-1 rounded-md text-xs font-medium cursor-pointer transition-colors duration-150"
          title="Use 12-hour time format"
        >
          12h
        </button>
        <button 
          type="button" 
          id="time-format-24h" 
          class="time-format-btn px-2.5 py-1 rounded-md text-xs font-medium cursor-pointer transition-colors duration-150"
          title="Use 24-hour time format"
        >
          24h
        </button>
      </div>

      <!-- Key Help Trigger -->
      <button 
        type="button" 
        id="trigger-keyboard-help" 
        class="hidden sm:inline-flex p-2 text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-50 hover:bg-zinc-100 dark:hover:bg-zinc-900 rounded-lg border border-transparent hover:border-zinc-200 dark:hover:border-zinc-800 transition-all duration-150 cursor-pointer shrink-0" 
        title="Keyboard Shortcuts (?)"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
      </button>

      <!-- Settings Menu Dropdown Container -->
      <div class="relative inline-block text-left">
        <button 
          type="button" 
          id="settings-menu-button" 
          class="p-2 text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-50 hover:bg-zinc-100 dark:hover:bg-zinc-900 rounded-lg border border-transparent hover:border-zinc-200 dark:hover:border-zinc-800 transition-all duration-150 cursor-pointer shrink-0" 
          title="Settings"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
          </svg>
        </button>
        <div 
          id="settings-dropdown" 
          class="absolute right-0 mt-1.5 w-44 origin-top-right rounded-lg bg-white dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 shadow-lg ring-1 ring-black/5 focus:outline-none hidden z-30 font-mono text-[11px]"
          role="menu"
          aria-orientation="vertical"
          aria-labelledby="settings-menu-button"
        >
          <div class="py-1" role="none">
            <button 
              type="button" 
              id="reset-workspace-button" 
              class="w-full text-left px-4 py-2 text-red-650 dark:text-red-400 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors cursor-pointer flex items-center gap-1.5 font-bold" 
              role="menuitem"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"/>
              </svg>
              Reset Workspace
            </button>
          </div>
        </div>
      </div>

      <!-- Share Button -->
      <button 
        type="button" 
        id="share-button" 
        class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 bg-zinc-900 text-zinc-50 hover:bg-zinc-800 dark:bg-zinc-50 dark:text-zinc-950 dark:hover:bg-zinc-200 font-medium text-xs rounded-md shadow-xs transition-all duration-150 cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
        </svg>
        <span class="hidden sm:inline">Copy Link</span>
      </button>

    </div>
  </div>
</header>

<!-- Inline Share Success Toast -->
<div 
  id="share-toast" 
  class="fixed bottom-4 left-1/2 -translate-x-1/2 z-50 bg-zinc-900 border border-zinc-800 text-zinc-50 dark:bg-zinc-50 dark:border-zinc-200 dark:text-zinc-950 px-4 py-2.5 rounded-lg shadow-lg font-mono text-xs flex items-center gap-2 pointer-events-none transition-all duration-200 transform translate-y-2 opacity-0"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-500 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="20 6 9 17 4 12"/>
  </svg>
  Meeting URL copied to clipboard!
</div>
