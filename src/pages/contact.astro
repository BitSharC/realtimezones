---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CitySearch from '../components/CitySearch.astro';
import KeyboardHelp from '../components/KeyboardHelp.astro';

const pageTitle = "Contact Us | RealTimeZones";
const pageDescription = "Get in touch with the team behind RealTimeZones. We appreciate your feedback, bug reports, and feature requests.";
const canonicalUrl = "https://realtimezones.com/contact";
---

<Layout title={pageTitle} description={pageDescription} url={canonicalUrl}>
  <div class="flex flex-col min-h-screen">
    <!-- Header component -->
    <Header />

    <!-- Main Content Area -->
    <main class="flex-grow max-w-[800px] w-full mx-auto px-4 md:px-8 py-16 flex flex-col gap-10 relative select-text">
      
      <!-- Atmospheric Mesh Gradient -->
      <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
        <div class="absolute top-[5%] left-1/2 -translate-x-1/2 w-[80%] h-[40%] rounded-full bg-[radial-gradient(circle,rgba(0,112,243,0.06)_0%,rgba(0,0,0,0)_70%)] dark:bg-[radial-gradient(circle,rgba(0,112,243,0.12)_0%,rgba(0,0,0,0)_70%)]"></div>
      </div>

      <!-- Section Header -->
      <section class="flex flex-col gap-3 border-b border-zinc-200 dark:border-zinc-800 pb-8">
        <span class="font-mono text-xs text-[#888888] uppercase tracking-widest">Get In Touch</span>
        <h1 class="text-3xl md:text-5xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-50 leading-tight">
          Contact Us.
        </h1>
        <p class="text-sm md:text-base text-zinc-500 dark:text-zinc-400 mt-2 font-sans leading-relaxed">
          Have feedback, a feature request, or need help? Send us a message and we'll reply as soon as possible. You can also reach us directly at <a href="mailto:bitsharc.dev@gmail.com" class="text-zinc-900 dark:text-zinc-50 underline hover:text-zinc-600 dark:hover:text-zinc-300 transition-colors">bitsharc.dev@gmail.com</a>.
        </p>
      </section>

      <!-- Contact Form Container -->
      <section class="w-full max-w-xl mx-auto">
        
        <!-- Submission Success State (Hidden by default) -->
        <div 
          id="success-banner" 
          class="hidden bg-emerald-500/5 dark:bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 p-6 rounded-xl flex flex-col gap-2 font-sans mb-8 animate-subtle"
        >
          <div class="flex items-center gap-2 font-semibold">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            Message Sent Successfully
          </div>
          <p class="text-sm text-emerald-700/80 dark:text-emerald-400/80">
            Thank you for reaching out to us. We have received your message and our team will get back to you shortly.
          </p>
          <button 
            type="button" 
            id="reset-form-btn" 
            class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 underline hover:text-emerald-800 mt-2 text-left cursor-pointer w-fit"
          >
            Send another message
          </button>
        </div>

        <!-- The Contact Form -->
        <form id="contact-form" class="flex flex-col gap-6 font-sans">
          
          <div class="flex flex-col gap-2">
            <label for="contact-name" class="text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 font-semibold">
              Full Name
            </label>
            <input 
              type="text" 
              id="contact-name" 
              name="name" 
              required
              placeholder="Name" 
              class="w-full h-10 px-3 bg-white dark:bg-zinc-950 text-zinc-900 dark:text-zinc-50 border border-zinc-200 dark:border-zinc-800 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-zinc-400 dark:focus:ring-zinc-700 focus:border-zinc-400 dark:focus:border-zinc-700 transition-all"
            />
          </div>

          <div class="flex flex-col gap-2">
            <label for="contact-email" class="text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 font-semibold">
              Email Address
            </label>
            <input 
              type="email" 
              id="contact-email" 
              name="email" 
              required
              placeholder="name@company.com" 
              class="w-full h-10 px-3 bg-white dark:bg-zinc-950 text-zinc-900 dark:text-zinc-50 border border-zinc-200 dark:border-zinc-800 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-zinc-400 dark:focus:ring-zinc-700 focus:border-zinc-400 dark:focus:border-zinc-700 transition-all"
            />
          </div>

          <div class="flex flex-col gap-2">
            <label for="contact-message" class="text-xs font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400 font-semibold">
              Message
            </label>
            <textarea 
              id="contact-message" 
              name="message" 
              rows="6" 
              required
              placeholder="How can we help you coordinate your timezone sync?" 
              class="w-full py-2.5 px-3 bg-white dark:bg-zinc-950 text-zinc-900 dark:text-zinc-50 border border-zinc-200 dark:border-zinc-800 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-zinc-400 dark:focus:ring-zinc-700 focus:border-zinc-400 dark:focus:border-zinc-700 transition-all resize-y min-h-[120px]"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <button 
            type="submit" 
            class="w-full sm:w-fit px-8 py-2.5 bg-zinc-900 text-zinc-50 hover:bg-zinc-800 dark:bg-zinc-50 dark:text-zinc-950 dark:hover:bg-zinc-200 font-medium text-sm rounded-full shadow-xs transition-all duration-150 cursor-pointer text-center"
          >
            Send Message
          </button>
          
        </form>
      </section>

    </main>

    <!-- Footer Area -->
    <footer class="border-t border-zinc-200 dark:border-zinc-800 py-6 bg-zinc-50 dark:bg-zinc-950/20 transition-colors duration-150">
      <div class="max-w-[1400px] w-full mx-auto px-4 md:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[10px] text-zinc-400 dark:text-zinc-500 font-mono select-none uppercase tracking-wider">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <span>RealTimeZones • Clean & Fast Time Sync</span>
          <span class="hidden sm:inline text-zinc-200 dark:text-zinc-800">|</span>
          <a href="/about" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">About</a>
          <a href="/contact" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors text-zinc-950 dark:text-zinc-50 font-semibold">Contact</a>
          <a href="/privacy" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Privacy</a>
          <a href="/terms" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">Terms</a>
        </div>
        <div class="text-xs font-mono text-zinc-500 dark:text-[#888888] normal-case tracking-normal select-text text-center sm:text-left">
          <p>Built with ❤️ by <span class="text-zinc-900 dark:text-[#ffffff]">BitSharc</span></p>
          <div class="mt-1">
            <span class="text-zinc-400 dark:text-[#666666]">More tools:</span>
            <ul class="mt-1 space-y-1">
              <li>
                <a href="https://courierprice.com" target="_blank" rel="noopener noreferrer" class="text-zinc-600 dark:text-[#888888] hover:text-zinc-900 dark:hover:text-[#ffffff] transition-colors duration-200">
                  ↳ CourierPrice
                </a>
              </li>
            </ul>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <button type="button" class="trigger-add-city hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors cursor-pointer">⌘K Search</button>
          <span>•</span>
          <button type="button" id="trigger-keyboard-help-footer" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors cursor-pointer">Shortcuts</button>
        </div>
      </div>
    </footer>
  </div>

  <!-- Command search dialog -->
  <CitySearch />

  <!-- Keyboard Shortcuts reference modal -->
  <KeyboardHelp />
</Layout>

<!-- Load Client Orchestrator Scripts Bundle for static pages -->
<script src="../scripts/static-pages.ts"></script>

<script>
  // Client-side Contact Form handling
  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  const successBanner = document.getElementById('success-banner') as HTMLDivElement | null;
  const resetFormBtn = document.getElementById('reset-form-btn') as HTMLButtonElement | null;

  if (contactForm && successBanner) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      
      // Get form data to verify inputs are correct
      const formData = new FormData(contactForm);
      const name = formData.get('name');
      const email = formData.get('email');
      const message = formData.get('message');
      
      if (name && email && message) {
        // Toggle view states
        contactForm.classList.add('hidden');
        successBanner.classList.remove('hidden');
      }
    });

    if (resetFormBtn) {
      resetFormBtn.addEventListener('click', () => {
        // Reset form controls
        contactForm.reset();
        contactForm.classList.remove('hidden');
        successBanner.classList.add('hidden');
      });
    }
  }
</script>
